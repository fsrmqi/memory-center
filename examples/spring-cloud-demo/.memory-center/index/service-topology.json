{
  "services": [
    {
      "name": "common-api",
      "service_name": "common-api",
      "path": "common-api",
      "type": "shared-library",
      "tags": [
        "contract"
      ]
    },
    {
      "name": "article-service",
      "service_name": "article-service",
      "path": "article-service",
      "type": "spring-boot-service",
      "tags": []
    },
    {
      "name": "task-service",
      "service_name": "task-service",
      "path": "task-service",
      "type": "spring-boot-task",
      "tags": []
    }
  ],
  "feign_edges": [
    {
      "from_project": "common-api",
      "to_service": "article-service",
      "to_project": "article-service",
      "client": "ArticleFeignClient",
      "file": "common-api/src/main/java/com/example/api/ArticleFeignClient.java"
    }
  ],
  "api_count": 1,
  "mq_topics": [
    {
      "topic": "article-pubtime-change",
      "consumers": [
        {
          "project": "task-service",
          "file": "task-service/src/main/java/com/example/task/ArticleMoveConsumer.java",
          "class": "ArticleMoveConsumer",
          "kind": "kafka"
        }
      ],
      "producers": []
    }
  ],
  "configs": [
    {
      "project": "article-service",
      "path": "article-service/application.yml",
      "values": {
        "spring.application.name": "article-service"
      }
    },
    {
      "project": "task-service",
      "path": "task-service/application.yml",
      "values": {
        "spring.application.name": "task-service",
        "article.move.topic": "article-pubtime-change"
      }
    }
  ]
}